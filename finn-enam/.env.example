# =============================================================================
# FINN frontend (Vite). Everything here is PUBLIC — it is compiled into the browser
# bundle. Never place API keys or secrets in this file. Server secrets live in
# backend/.env (see backend/.env.example) or ../.env.local written by `neon deploy`.
# =============================================================================

# Optional. Leave unset to call the API on the same origin (/api), which is how both
# `npm run dev` (Vite proxy → :3001) and production (backend serves the built app) work.
# Set only when the frontend is hosted on a different origin from the API.
VITE_API_BASE_URL=

# Reviewer demo login. When enabled, the login page pre-fills these credentials and offers
# "Sign in to demo". They are compiled into the public bundle, so they must belong to the dedicated
# demo account only (backend DEMO_USER_EMAIL / DEMO_USER_PASSWORD, with DEMO_MODE_ENABLED=true).
VITE_DEMO_LOGIN_ENABLED=false
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
