# ==============================================================================
# FINN — Institutional Financial Investment Agent
# Environment Configuration Template
# ENAM AI Engineer Build Challenge
# ==============================================================================

# Backend Server Port (defaults to 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 1. Neon Hosted PostgreSQL Database
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[neon-host].neon.tech/[dbname]?sslmode=require
# If left empty, FINN automatically operates in resilient In-Memory Grounded Mode
# with all 9 core tables pre-loaded with verified primary disclosures.
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# Google Gemini 2.0 API Key for real-time structured primary document extraction.
# Get a key at: https://aistudio.google.com/
# If left empty, FINN automatically operates in deterministic grounded extraction mode
# with verified primary evidence and zero financial hallucinations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. Mobile Client API Base URL
# ------------------------------------------------------------------------------
# Used by React Native Expo mobile client.
# For local web preview: http://localhost:3001/api
# For physical devices over LAN: http://<your-local-ip>:3001/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api

