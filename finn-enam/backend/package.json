{
  "name": "@finn/backend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "demo:seed": "tsx src/db/seedDemo.ts",
    "jobs:run": "tsx src/jobs/cli.ts",
    "test": "tsx --test test/engine.test.ts test/ai.test.ts test/analysis.test.ts",
    "test:api": "tsx --test --test-concurrency=1 test/api.integration.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.137",
    "@ai-sdk/google": "^3.0.140",
    "@ai-sdk/openai": "^3.0.135",
    "@ai-sdk/openai-compatible": "^2.0.88",
    "@neon/ai-sdk-provider": "^1.3.0",
    "@neon/realtime": "^0.1.2",
    "@node-rs/argon2": "^2.2.2",
    "ai": "^6.0.320",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
