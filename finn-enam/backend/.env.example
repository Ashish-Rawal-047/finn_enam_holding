# =============================================================================
# FINN backend — server-side configuration. Copy to backend/.env (git-ignored).
# Never put any of these values in frontend code or commit them.
# =============================================================================

# --- Neon (written automatically to ../.env.local by `neon deploy` / `neon env pull`)
# Pooled connection (hostname contains -pooler) for application traffic.
DATABASE_URL=
# Direct connection for migrations (`npm run db:migrate`).
DATABASE_URL_UNPOOLED=
# Neon Realtime (preview.realtime in neon.ts). Leave unset to poll notifications instead.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# --- Auth: generate each with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Server
PORT=3001
CORS_ORIGINS=http://localhost:5173
ENABLE_SCHEDULER=true
SERVE_FRONTEND=true

# --- AI research provider. Leave AI_PROVIDER unset to run without AI: research then shows
# reported facts and calculated metrics only, and AI sections are marked "Unavailable".
#   google – Google Gemini (the only supported provider; the free tier is enough)
# FINN does not guess model names: set AI_MODEL to a model id your provider serves.
# Example (Google Gemini API key from https://aistudio.google.com):
#   AI_PROVIDER=google  AI_MODEL=gemini-3.5-flash-lite  AI_REASONING_MODEL=gemini-3.5-flash
#   AI_EMBEDDING_MODEL=gemini-embedding-001
AI_PROVIDER=
AI_API_KEY=
# Optional: override the Gemini API address (proxies, tests). Leave empty normally.
AI_BASE_URL=
# Fast model: event classification, commitment extraction, precedent comparison, and the
# automatic fallback when the reasoning model is overloaded or out of quota.
AI_MODEL=
# Optional: a stronger model for research synthesis (defaults to AI_MODEL).
AI_REASONING_MODEL=
# Optional: embeddings for semantic Event Memory matching (structured matching otherwise).
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024
# Optional tuning. Thinking level (Gemini 3: minimal|low|medium|high; unset = model default):
# lower is faster and cheaper, higher reasons more.
AI_THINKING_LEVEL=
# Per-attempt timeout (ms) and retries for transient errors (rate limit, overload, timeout).
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Optional USD prices per million tokens, used only to report cost in GET /api/ai/usage.
# FINN does not assume provider prices; leave unset to report tokens without cost.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# --- Data providers
# yfinance: Yahoo Finance via the Python bridge in backend/python (see README). Unofficial,
# end-of-day/delayed data for research and personal use; falls back to "demo" automatically
# when the Python environment is missing. "demo" = labelled demonstration fixtures.
# Optional: Python interpreter with yfinance (defaults to backend/python/.venv).
YFINANCE_PYTHON=
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=
COMPANY_INFO_PROVIDER=yfinance
COMPANY_INFO_API_KEY=
FINANCIALS_PROVIDER=yfinance
FINANCIALS_API_KEY=
# No free, licensed NSE/BSE filings feed is wired yet: announcements stay demo.
ANNOUNCEMENTS_PROVIDER=demo
ANNOUNCEMENTS_API_KEY=
TRANSCRIPTS_PROVIDER=none
TRANSCRIPTS_API_KEY=

# --- Company logos
# Optional logo.dev token for full-resolution logos. Without it, logos come from Google's favicon
# service and the company's official website. Logos are proxied by the API; the token never reaches browsers.
LOGO_DEV_TOKEN=

# --- Reviewer demo account
# A dedicated, shared account holding demo data only. Its credentials are PUBLIC: the login page
# pre-fills them (VITE_DEMO_* in the frontend env must match). Never reuse a personal account or
# password here. Created/updated idempotently at API start-up and by `npm run demo:seed`.
# With DEMO_MODE_ENABLED=false the account cannot sign in.
DEMO_MODE_ENABLED=false
DEMO_USER_EMAIL=reviewer@finn.demo
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Reviewer
