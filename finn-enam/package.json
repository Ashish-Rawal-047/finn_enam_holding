{
  "name": "finn-enam",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix backend run dev",
    "build": "tsc -p tsconfig.json && vite build && npm --prefix backend run build",
    "build:web": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "start": "npm --prefix backend run start",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix backend run typecheck",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "demo:seed": "npm --prefix backend run demo:seed",
    "test": "npm --prefix backend test",
    "test:api": "npm --prefix backend run test:api",
    "audit:ui": "node scripts/ui-audit.mjs",
    "postinstall": "npm --prefix backend install --no-audit --no-fund"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neon/realtime": "^0.1.2",
    "@neon/realtime-react": "^0.1.1",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
